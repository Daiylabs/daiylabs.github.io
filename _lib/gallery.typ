#import "/_calepin/calepin.typ" as calepin

// Image dimensions are generated by scripts/prepare-gallery.py.
#let _dims = json("/_lib/gallery-images.json")

#let _asset(path) = calepin.url(path)

/// One gallery cell: a thumbnail that opens the lossless PNG in PhotoSwipe.
/// - name:   base filename shared by the full PNG and the thumbnail
/// - label:  figure sublabel, e.g. "a"
/// - note:   short description shown under the thumbnail and in the lightbox
#let photo(name, label: none, note: none) = {
  let dim = _dims.at(name)
  let caption = if label != none and note != none {
    [#label · #note]
  } else if note != none {
    note
  } else if label != none {
    label
  } else {
    name
  }

  html.elem("a", attrs: (
    href: _asset("/assets/gallery/full/" + name + ".png"),
    class: "mx-gallery__item",
    "data-pswp-width": str(dim.width),
    "data-pswp-height": str(dim.height),
    "aria-label": "Open image " + name + " at full resolution",
  ))[
    #html.elem("img", attrs: (
      srcset: _asset("/assets/gallery/thumbs/" + name + ".jpg") + " 480w",
      sizes: "(max-width: 30rem) 100vw, (max-width: 64rem) 50vw, 20vw",
      width: str(dim.width),
      height: str(dim.height),
      alt: name,
      class: "mx-gallery__thumb",
      loading: "lazy",
      decoding: "async",
    ))
    #if label != none [
      #html.elem("span", attrs: (class: "mx-gallery__label"))[#label]
    ]
    #if note != none [
      #html.elem("span", attrs: (class: "mx-gallery__note"))[#note]
    ]
    #html.elem("span", attrs: (class: "mx-gallery__caption-src"))[#caption]
  ]
}

/// A responsive grid of gallery cells. All grids on the page form a single
/// PhotoSwipe gallery, so the arrow keys move through every image.
#let gallery(columns: 5, label: none, body) = {
  let attrs = (
    class: "mx-gallery",
    style: "grid-template-columns: repeat(" + str(columns) + ", minmax(0, 1fr));",
    "data-pswp-css": _asset("/assets/photoswipe/photoswipe.css"),
    "data-pswp-lightbox": _asset("/assets/photoswipe/photoswipe-lightbox.esm.js"),
    "data-pswp-module": _asset("/assets/photoswipe/photoswipe.esm.js"),
  )
  if label != none {
    attrs.insert("data-label", label)
  }
  html.elem("div", attrs: attrs)[#body]
}
